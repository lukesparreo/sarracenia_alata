#!/bin/bash
#SBATCH --job-name=plastome_map
#SBATCH --output=plastome_map_%A_%a.out
#SBATCH --error=plastome_map_%A_%a.err
#SBATCH --array=0-24
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=04:00:00

set -euo pipefail

# ------------------------------------------------------------
#Maps each sample's trimmed reads back to its own assembled plastome using BWA-MEM2
#Next, summarizes read depth/coverage with samtools
# ------------------------------------------------------------

module load bwa-mem2/2.3
module load samtools/1.24

cd "$SLURM_SUBMIT_DIR"

# Get list of plastomes
mapfile -t PLASTOMES < <(find . -maxdepth 1 -name "*_plastome.fasta" -type f | sort)

PLASTOME="${PLASTOMES[$SLURM_ARRAY_TASK_ID-1]}"

if [[ -z "${PLASTOME:-}" ]]; then
    echo "No plastome found for array task $SLURM_ARRAY_TASK_ID"
    exit 1
fi

# Sample name
SAMPLE=$(basename "$PLASTOME" "_plastome.fasta")

echo "======================================"
echo "Sample: $SAMPLE"
echo "Plastome: $PLASTOME"
echo "======================================"

# Input reads
R1="../01_trimming/combined/${SAMPLE}/${SAMPLE}_R1.fq.gz"
R2="../01_trimming/combined/${SAMPLE}/${SAMPLE}_R2.fq.gz"

if [[ ! -f "$R1" ]]; then
    echo "ERROR: R1 not found: $R1"
    exit 1
fi

if [[ ! -f "$R2" ]]; then
    echo "ERROR: R2 not found: $R2"
    exit 1
fi

# Create BWA index if needed
if [[ ! -f "${PLASTOME}.bwt.2bit.64" ]]; then
    echo "Creating BWA-MEM2 index..."
    bwa-mem2 index "$PLASTOME"
fi

# Output BAM
BAM="${SAMPLE}_plastome.bam"

echo "Mapping reads..."

bwa-mem2 mem \
    -t "$SLURM_CPUS_PER_TASK" \
    "$PLASTOME" \
    "$R1" \
    "$R2" \
    | samtools sort \
        -@ "$SLURM_CPUS_PER_TASK" \
        -o "$BAM" -

echo "Indexing BAM..."

samtools index "$BAM"

echo "Generating coverage summary..."

samtools coverage "$BAM" > "${SAMPLE}_coverage.txt"

echo "Finished $SAMPLE"
