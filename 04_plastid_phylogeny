#!/bin/bash
#SBATCH --job-name=iqtree_plastome
#SBATCH --output=iqtree_plastome_%j.out
#SBATCH --error=iqtree_plastome_%j.err
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=02:00:00

set -euo pipefail

cd "$SLURM_SUBMIT_DIR"

module load iqtree/3.1.3

INPUT="plastomes_aligned_renamed.fasta"
PREFIX="plastome_IQtree"

iqtree3 \
    -s "$INPUT" \
    -m MFP \
    -B 1000 \
    -T 8 \
    --prefix "$PREFIX"
