#!/bin/bash
#SBATCH --job-name=fastp
#SBATCH --array=0-24%4
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=04:00:00
#SBATCH --output=fastp_%A_%a.out
#SBATCH --error=fastp_%A_%a.err

#Adapter/quality trimming of paired-end genome skimming reads using fastp
#For plastid analysis, input FASTQ files were concatenated across sequencing lanes before this step

module load fastp/1.3.6

BASE="/path/to/01_trimming"
OUT="/path/to/02_getorganelle"

#Replace with real sample IDs
SAMPLES=(
    sample01
    sample02
    sample03...
)

SAMPLE=${SAMPLES[$SLURM_ARRAY_TASK_ID]}

mkdir -p "$OUT/$SAMPLE"

R1="$BASE/combined/$SAMPLE/${SAMPLE}_R1.fq.gz"
R2="$BASE/combined/$SAMPLE/${SAMPLE}_R2.fq.gz"

echo "========================================"
echo "Sample: $SAMPLE"
echo "R1: $R1"
echo "R2: $R2"
echo "CPUs: $SLURM_CPUS_PER_TASK"
echo "Started: $(date)"
echo "========================================"

fastp \
    --in1 "$R1" \
    --in2 "$R2" \
    --out1 "$OUT/$SAMPLE/${SAMPLE}_R1.trimmed.fq.gz" \
    --out2 "$OUT/$SAMPLE/${SAMPLE}_R2.trimmed.fq.gz" \
    --thread "$SLURM_CPUS_PER_TASK" \
    --detect_adapter_for_pe \
    --qualified_quality_phred 20 \
    --length_required 30 \
    --html "$OUT/$SAMPLE/${SAMPLE}_fastp.html" \
    --json "$OUT/$SAMPLE/${SAMPLE}_fastp.json"

STATUS=$?

echo "========================================"
echo "Sample: $SAMPLE"
echo "Exit status: $STATUS"
echo "Finished: $(date)"
echo "========================================"

exit $STATUS
