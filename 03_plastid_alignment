#!/bin/bash
#SBATCH --job-name=mafft_plastomes
#SBATCH --output=mafft_plastomes.out
#SBATCH --error=mafft_plastomes.err
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=02:00:00

set -euo pipefail

# ------------------------------------------------------------
#Concatenates assembled plastomes into a single multi-FASTA and aligns them with MAFFT
# ------------------------------------------------------------
INPUT="plastomes_for_mafft.fasta"
OUTPUT="../04_plastid_check_and_phylogeny/plastomes_aligned.fasta"

echo "Creating combined input FASTA..."

rm -f "$INPUT"

#Replace with real sample IDs
for f in \
    sample_1_plastome.fasta \
    sample_2_plastome.fasta \
    sample_3_plastome.fasta \
    ...
do
    sample="${f%_plastome.fasta}"

    echo ">$sample" >> "$INPUT"
    tail -n +2 "$f" >> "$INPUT"
done

echo "Input FASTA headers:"
grep "^>" "$INPUT"

echo
echo "Number of input sequences:"
grep -c "^>" "$INPUT"

#Update this count to match your actual number of samples
if [[ "$(grep -c "^>" "$INPUT")" -ne 18 ]]; then
    echo "ERROR: Expected 18 plastomes."
    exit 1
fi

echo "Running MAFFT..."
date

mafft \
    --auto \
    --thread 8 \
    "$INPUT" \
    > "$OUTPUT"

echo "======================================"
echo "MAFFT alignment complete"
echo "======================================"
date

echo "Number of aligned sequences:"
grep -c "^>" "$OUTPUT"

echo "Aligned FASTA headers:"
grep "^>" "$OUTPUT"

echo
echo "Alignment file:"
ls -lh "$OUTPUT"
