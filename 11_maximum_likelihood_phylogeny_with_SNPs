#!/bin/bash
#SBATCH --job-name=iq25_02
#SBATCH --partition=defq
#SBATCH --cpus-per-task=64
#SBATCH --mem=180G
#SBATCH --time=72:00:00
#SBATCH --output=iq25_%j.out
#SBATCH --error=iq25_%j.err

set -euo pipefail

#IQ-TREE v3.1.3 to perform maximum-likelihood phylogenetic inference
#Parameter MFP+ASC selects the best-fit substitution model while applying ascertainment-bias correction (our alignments contain only variable sites)
#The example here is for the 25% missingness dataset, the exact same script was run for the 50% and 75% missingness datasets and replicates

IQTREE="/path/to/iqtree3"

ALIGNMENT="phylips/filtered_25pct_missing_variable_new.phy"
PREFIX="results/filtered_25pct_missing"

"$IQTREE" \
    -s "$ALIGNMENT" \
    -st DNA \
    -m MFP+ASC \
    -T "$SLURM_CPUS_PER_TASK" \
    -B 1000 \
    --alrt 1000 \
    --prefix "$PREFIX"
